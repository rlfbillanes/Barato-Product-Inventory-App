@namespace BaratoInventory.Blazor.Components

<div class="search-container">
    <div class="search-input-wrapper">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" 
               class="form-control search-input" 
               placeholder="Search products by title..." 
               value="@SearchTerm" 
               data-tooltip="Live Search: Type keywords to filter products by title in real-time"
               data-tooltip-pos="top"
               @oninput="HandleInput"
               @onkeydown="HandleKeyDown" />

        @if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            <button class="clear-search-btn" @onclick="ClearSearch" data-tooltip="Clear search keywords" data-tooltip-pos="top">
                &times;
            </button>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? SearchTerm { get; set; }

    [Parameter]
    public EventCallback<string> OnSearchChanged { get; set; }

    private System.Timers.Timer? _debounceTimer;

    protected override void OnInitialized()
    {
        _debounceTimer = new System.Timers.Timer(350);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += async (s, e) =>
        {
            await InvokeAsync(async () =>
            {
                await OnSearchChanged.InvokeAsync(SearchTerm ?? string.Empty);
            });
        };
    }

    private void HandleInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString();
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _debounceTimer?.Stop();
            await OnSearchChanged.InvokeAsync(SearchTerm ?? string.Empty);
        }
    }

    private async Task ClearSearch()
    {
        SearchTerm = string.Empty;
        _debounceTimer?.Stop();
        await OnSearchChanged.InvokeAsync(string.Empty);
    }
}
