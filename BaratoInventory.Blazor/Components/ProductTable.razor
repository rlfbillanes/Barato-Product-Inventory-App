@namespace BaratoInventory.Blazor.Components
@using BaratoInventory.Core.DTOs
@using BaratoInventory.Blazor.Services
@inject IProductApiClient ApiClient

<!-- Desktop & Tablet Table View (Visible on >= 769px) -->
<div class="desktop-table-view table-responsive product-table-card">
    <table class="table custom-product-table">
        <thead>
            <tr>
                <th class="col-sortable" @onclick='() => SortColumn("id")' data-tooltip="Click to sort by Product ID" data-tooltip-pos="bottom">
                    ID @GetSortIndicator("id")
                </th>
                <th class="col-image" data-tooltip="Product photo. Hover over thumbnails to zoom" data-tooltip-pos="bottom">
                    Item
                </th>
                <th class="col-sortable" @onclick='() => SortColumn("name")' data-tooltip="Click to sort alphabetically by Product Title" data-tooltip-pos="bottom">
                    Product Title @GetSortIndicator("name")
                </th>
                <th class="col-sortable" @onclick='() => SortColumn("category")' data-tooltip="Click to sort by Department/Category" data-tooltip-pos="bottom">
                    Category @GetSortIndicator("category")
                </th>
                <th class="col-sortable" @onclick='() => SortColumn("price")' data-tooltip="Click to sort by Unit Price (₱)" data-tooltip-pos="bottom">
                    Unit Price @GetSortIndicator("price")
                </th>
                <th class="col-sortable" @onclick='() => SortColumn("quantity")' data-tooltip="Click to sort by Stock count" data-tooltip-pos="bottom">
                    Inventory Level @GetSortIndicator("quantity")
                </th>
                <th class="col-static" data-tooltip="Quick management actions: adjust stock, edit, or delete" data-tooltip-pos="bottom">
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            @if (IsLoading)
            {
                <LoadingSkeleton RowCount="@PageSize" />
            }
            else if (Products != null && Products.Any())
            {
                @foreach (var product in Products)
                {
                    <ProductRow Product="@product" 
                                OnEditRequested="OnEditRequested" 
                                OnDeleteRequested="OnDeleteRequested" 
                                OnStockAdjusted="OnStockAdjusted" />
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="empty-state-cell">
                        <div class="empty-state">
                            <div class="empty-icon">&#128230;</div>
                            <h4 class="empty-title">No products found</h4>
                            <p class="empty-subtitle">Try adjusting your search criteria, clearing category filters, or add a new product.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mobile Cards View (Visible on < 769px: Zero horizontal scrolling, App-Like Experience) -->
<div class="mobile-products-view">
    @if (IsLoading)
    {
        @for (int i = 0; i < PageSize; i++)
        {
            <div class="mobile-product-card mobile-skeleton-card">
                <div class="mobile-card-top-row">
                    <div class="skeleton-box" style="width: 55px; height: 18px;"></div>
                    <div class="skeleton-box" style="width: 75px; height: 18px;"></div>
                </div>
                <div class="mobile-card-main-row">
                    <div class="skeleton-box skeleton-thumb" style="width: 54px; height: 54px; border-radius: 8px;"></div>
                    <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
                        <div class="skeleton-box" style="width: 85%; height: 16px;"></div>
                        <div class="skeleton-box" style="width: 45%; height: 14px;"></div>
                    </div>
                </div>
                <div class="mobile-card-action-row">
                    <div class="skeleton-box" style="width: 100px; height: 32px;"></div>
                    <div class="skeleton-box" style="width: 110px; height: 32px;"></div>
                </div>
            </div>
        }
    }
    else if (Products != null && Products.Any())
    {
        @foreach (var product in Products)
        {
            <div class="mobile-product-card @(product.Quantity == 0 ? "card-out-of-stock" : "")">
                <!-- Top Row: ID Badge, Category & Big Price -->
                <div class="mobile-card-top-row">
                    <div class="mobile-card-meta">
                        <span class="mobile-id-badge">#@product.Id</span>
                        <span class="badge badge-category">@product.Category</span>
                    </div>
                    <div class="mobile-price-badge">
                        ₱@product.Price.ToString("N2")
                    </div>
                </div>

                <!-- Main Row: Thumbnail + Title + Stock Status -->
                <div class="mobile-card-main-row">
                    <div class="mobile-thumb-box">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            var resolvedUrl = ApiClient.ResolveImageUrl(product.ImageUrl);
                            <img src="@resolvedUrl" alt="@product.Name" class="mobile-thumb-img" loading="lazy" />
                        }
                        else
                        {
                            <div class="mobile-thumb-placeholder">
                                <span>📦</span>
                            </div>
                        }
                    </div>
                    <div class="mobile-info-box">
                        <h4 class="mobile-product-title">@product.Name</h4>
                        <div class="mobile-stock-status">
                            @if (product.Quantity <= 0)
                            {
                                <span class="badge badge-danger">Out of Stock (0)</span>
                            }
                            else if (product.Quantity <= 10)
                            {
                                <span class="badge badge-warning">Low Stock (@product.Quantity)</span>
                            }
                            else
                            {
                                <span class="badge badge-success">In Stock (@product.Quantity)</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Footer: Quick Stock Stepper + Edit/Delete Buttons -->
                <div class="mobile-card-action-row">
                    <div class="mobile-stock-stepper">
                        <span class="stepper-label">Qty:</span>
                        <button type="button" 
                                class="btn btn-stock-step" 
                                disabled="@(product.Quantity <= 0)" 
                                @onclick="() => AdjustStock(product, -1)" 
                                aria-label="Decrease stock">-</button>
                        <span class="stepper-count">@product.Quantity</span>
                        <button type="button" 
                                class="btn btn-stock-step" 
                                @onclick="() => AdjustStock(product, 1)" 
                                aria-label="Increase stock">+</button>
                    </div>
                    <div class="mobile-actions-group">
                        <button type="button" class="btn btn-sm btn-outline-primary mobile-action-btn" 
                                @onclick="() => OnEditRequested.InvokeAsync(product)">
                            ✏️ Edit
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger mobile-action-btn" 
                                @onclick="() => OnDeleteRequested.InvokeAsync(product)">
                            🗑️ Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="mobile-empty-state">
            <div class="empty-icon">&#128230;</div>
            <h4 class="empty-title">No products found</h4>
            <p class="empty-subtitle">Try adjusting your search criteria, clearing category filters, or add a new product.</p>
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<ProductDto>? Products { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public string CurrentSortBy { get; set; } = "id";

    [Parameter]
    public bool IsDescending { get; set; } = true;

    [Parameter]
    public EventCallback<string> OnSortColumnClicked { get; set; }

    [Parameter]
    public EventCallback<ProductDto> OnEditRequested { get; set; }

    [Parameter]
    public EventCallback<ProductDto> OnDeleteRequested { get; set; }

    [Parameter]
    public EventCallback<(int ProductId, int Change, byte[] RowVersion)> OnStockAdjusted { get; set; }

    private async Task SortColumn(string column)
    {
        await OnSortColumnClicked.InvokeAsync(column);
    }

    private string GetSortIndicator(string column)
    {
        if (CurrentSortBy.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            return IsDescending ? "▼" : "▲";
        }
        return "⇅";
    }

    private async Task AdjustStock(ProductDto product, int change)
    {
        await OnStockAdjusted.InvokeAsync((product.Id, change, product.RowVersion));
    }
}
